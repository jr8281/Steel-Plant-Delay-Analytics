# --- Database Configuration ---

POSTGRES_DB=steelplant
POSTGRES_USER=steeluser
POSTGRES_PASSWORD=your_strong_postgres_password_here
DATABASE_URL=postgresql+psycopg2://steeluser:your_strong_postgres_password_here@db:5432/steelplant

# --- Backend API Configuration ---
ENVIRONMENT=development
# Set to: development | staging | production
# In production: ENVIRONMENT=production and JWT_SECRET_KEY must be a strong random secret

JWT_SECRET_KEY=your_random_32_char_secret_key_change_before_production
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"

ACCESS_TOKEN_MINUTES=480
# Token expiry duration in minutes (480 = 8 hours)

CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# Comma-separated list of allowed frontend origins

# --- AI Assistant (Optional) ---
GROQ_API_KEY=your_groq_api_key_here
# Get free API key: https://groq.com
# Without this, AI Assistant feature gracefully degrades

# --- Logging & Debugging ---
LOG_LEVEL=INFO
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Use DEBUG for development, INFO for production

# --- Seed Data (Development Only, Not Used in Production) ---
SEED_ADMIN_PASSWORD=admin123
SEED_OPERATOR_PASSWORD=operator123

# --- Security Headers (for production) ---
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated list of allowed hosts (prevents Host header attacks)
